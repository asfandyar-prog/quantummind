# QuantumMind frontend — environment template.
# Copy to .env.local and adjust. .env / .env.local are gitignored.

# Origin of the QuantumMind backend, with no trailing slash.
# Vite inlines this at BUILD time (not runtime), so a deployed frontend must be
# rebuilt to point at a different backend. Omit it entirely for local dev — the
# code falls back to http://localhost:8000 (see src/lib/api.js).
#
# Local dev (default if unset):
VITE_API_URL=http://localhost:8000
#
# Deployed, e.g. Railway:
# VITE_API_URL=https://quantummind-backend.up.railway.app
